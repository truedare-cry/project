//======================================================================
// tb_sha3.v — SHA3 Testbench với đầy đủ test cases
//
// Test cases:
//   Group 1 — Empty message          (đã có)
//   Group 2 — Single byte 0x00       (mới)
//   Group 3 — Single byte 0xFF       (mới)
//   Group 4 — Single byte 'a' 0x61   (mới)
//   Group 5 — Short "abc"            (đã có)
//   Group 6 — Alphabet a-z (26 bytes)(mới)
//   Group 7 — Exact block boundary   (mới)
//   Group 8 — Long 200x 0xA3         (đã có)
//   Group 9 — All zeros 200 bytes    (mới)
//======================================================================

`define SHA3_224_BLOCK_BITS  1152
`define SHA3_256_BLOCK_BITS  1088
`define SHA3_384_BLOCK_BITS   832
`define SHA3_512_BLOCK_BITS   576

`define SHA3_224_OUTPUT_BITS  224
`define SHA3_256_OUTPUT_BITS  256
`define SHA3_384_OUTPUT_BITS  384
`define SHA3_512_OUTPUT_BITS  512

module tb_sha3 ();

    //------------------------------------------------------------------
    // GROUP 1: Empty message
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_EMPTY = {
        224'h6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_EMPTY = {
        256'ha7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_EMPTY = {
        384'h0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_EMPTY =
        512'h00a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26;

    //------------------------------------------------------------------
    // GROUP 2: Single byte 0x00
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ZERO1 = {
        224'hbdd5167212d2dc69665f5a8875ab87f23d5ce7849132f56371a19096,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ZERO1 = {
        256'h5d53469f20fef4f8eab52b88044ede69c77a6a68a60728609fc4a65ff531e7d0,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ZERO1 = {
        384'h127677f8b66725bbcb7c3eae9698351ca41e0eb6d66c784bd28dcdb3b5fb12d0c8e840342db03ad1ae180b92e3504933,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ZERO1 =
        512'h7127aab211f82a18d06cf7578ff49d5089017944139aa60d8bee057811a15fb55a53887600a3eceba004de51105139f32506fe5b53e1913bfa6b32e716fe97da00;

    //------------------------------------------------------------------
    // GROUP 3: Single byte 0xFF
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_FF1 = {
        224'h624edc8a3c0c9d42bc224f0bf37040483432d7a1aeb68935e80f1e1c,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_FF1 = {
        256'h444b89ecce395aec5dc98f19defd3a23bca0822fc72226f58ca46a17eeeca442,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_FF1 = {
        384'hbb90261c81ad316a92b5a754b983c5f09c7f22a95c34af914a46cdc50704d91279db547e47dbb00f9e2310fce0b1a028,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_FF1 =
        512'ha6f098adf45424539eb214272e0436894bb6fe3f22f5bf45725e1d4f37313a9547415ca108ea84664995d9ccd3983dc21806765fb8e20d6b686ce51ee6583ec800;

    //------------------------------------------------------------------
    // GROUP 4: Single byte 'a' (0x61)
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_A1 = {
        224'h9e86ff69557ca95f405f081269685b38e3a819b309ee942f482b6a8b,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_A1 = {
        256'h80084bf2fba02475726feb2cab2d8215eab14bc6bdd8bfb2c8151257032ecd8b,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_A1 = {
        384'h1815f774f320491b48569efec794d249eeb59aae46d22bf77dafe25c5edc28d7ea44f93ee1234aa88f61c91912a4ccd9,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_A1 =
        512'h697f2d856172cb8309d6b8b97dac4de344b549d4dee61edfb4962d8698b7fa803f4f93ff24393586e28b5b957ac3d1d369420ce53332712f997bd336d09ab02a00;

    //------------------------------------------------------------------
    // GROUP 5: Short "abc"
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ABC = {
        224'he642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ABC = {
        256'h3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ABC = {
        384'hec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ABC =
        512'h00b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0;

    //------------------------------------------------------------------
    // GROUP 6: Alphabet a-z (26 bytes)
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_AZ = {
        224'h5cdeca81e123f87cad96b9cba999f16f6d41549608d4e0f4681b8239,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_AZ = {
        256'h7cab2dc765e21b241dbc1c255ce620b29f527c6d5e7f5f843e56288f0d707521,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_AZ = {
        384'hfed399d2217aaf4c717ad0c5102c15589e1c990cc2b9a5029056a7f7485888d6ab65db2370077a5cadb53fc9280d278f,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_AZ =
        512'haf328d17fa28753a3c9f5cb72e376b90440b96f0289e5703b729324a975ab384eda565fc92aaded143669900d761861687acdc0a5ffa358bd0571aaad80aca6800;

    //------------------------------------------------------------------
    // GROUP 7: Exact block boundary (0xA3 fills block exactly)
    // SHA3-256: 136 bytes = 34 words = exact 1 block
    // SHA3-512:  72 bytes = 18 words = exact 1 block
    //------------------------------------------------------------------
    localparam [511:0] SHA3_256_EXACT_BLK = {
        256'h0adf6bfb359ae40019b67d8c49c361574b70242a6b752de6f9e0d426ca177f7a,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_512_EXACT_BLK =
        512'hd24ce75b87c7be36e3fedbaa285f563d3efcc13663f5eb2fdd0c60033dab04e894d343b3971bc0c9ba30e0dde18106cbaaa955c8c3c0bf1ec3490aafcae15788;

    //------------------------------------------------------------------
    // GROUP 8: Long 200x 0xA3
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_LONG = {
        224'h9376816ABA503F72F96CE7EB65AC095DEEE3BE4BF9BBC2A1CB7E11E0,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_LONG = {
        256'h79F38ADEC5C20307A98EF76E8324AFBFD46CFD81B22E3973C65FA1BD9DE31787,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_LONG = {
        384'h1881DE2CA7E41EF95DC4732B8F5F002B189CC1E42B74168ED1732649CE1DBCDD76197A31FD55EE989F2D7050DD473E8F,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_LONG =
        512'hE76DFAD22084A8B1467FCF2FFA58361BEC7628EDF5F3FDC0E4805DC48CAEECA81B7C13C30ADF52A3659584739A2DF46BE589C51CA1A4A8416DF6545A1CE8BA00;

    //------------------------------------------------------------------
    // GROUP 9: All zeros 200 bytes
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ZEROS = {
        224'hc183b88a86c9c2d9d71f44d96983ec428d0fb59f923e337d8b339e0f,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ZEROS = {
        256'h2b43036c229ba512995f91fdb46fcd5327a4dc834d86d6e0f58a08053346dc2e,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ZEROS = {
        384'hd594703d816a1aeb814436c53ec54d7100c5edfb4f806a253fbf6b052864d1000b5a1a66a066b5d680bfae9ac3e5bcf6,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ZEROS =
        512'hfee1198b89e041af5a26a217e4217a66c628c78d11c1fbb482b3643153f3cf0c04ae421c7e530e19584a494c1f3bd4713ca169a98b937ddf0b9d4d09fadecde900;

    //------------------------------------------------------------------
    // Timing
    //------------------------------------------------------------------
    parameter CLK_HALF_PERIOD = 2;
    parameter CLK_PERIOD      = 2 * CLK_HALF_PERIOD;

    //------------------------------------------------------------------
    // Signals
    //------------------------------------------------------------------
    reg         tb_clk;
    reg         tb_rst_n;
    reg         tb_we;
    reg  [6:0]  tb_addr;
    reg  [31:0] tb_wr_data;
    reg         tb_dut_init;
    reg         tb_dut_next;
    wire [31:0] tb_rd_data;
    wire        tb_rdy;

    integer     i;
    integer     num_err;
    integer     block_words;
    integer     output_words;
    integer     total_bits;

    reg [511:0] hash_shreg;
    reg [31:0]  hash_word;
    reg         mismatch;

    //------------------------------------------------------------------
    // DUT
    //------------------------------------------------------------------
    sha3 dut (
        .clk    (tb_clk),
        .nreset (tb_rst_n),
        .w      (tb_we),
        .addr   (tb_addr),
        .din    (tb_wr_data),
        .dout   (tb_rd_data),
        .init   (tb_dut_init),
        .next   (tb_dut_next),
        .ready  (tb_rdy)
    );

    initial tb_clk = 1'b0;
    always  #CLK_HALF_PERIOD tb_clk = ~tb_clk;

    //------------------------------------------------------------------
    // Task: init_sim
    //------------------------------------------------------------------
    task init_sim;
        begin
            tb_clk=1'b0; tb_rst_n=1'b0; tb_we=1'b0;
            tb_addr=7'd0; tb_wr_data=32'h0;
            tb_dut_init=1'b0; tb_dut_next=1'b0;
        end
    endtask

    //------------------------------------------------------------------
    // Task: reset_dut
    //------------------------------------------------------------------
    task reset_dut;
        begin
            $display("*** Toggling reset...");
            tb_rst_n=1'b0; #(4*CLK_HALF_PERIOD);
            tb_rst_n=1'b1; #(CLK_PERIOD);
        end
    endtask

    //------------------------------------------------------------------
    // Task: write_block_word
    // widx = 32-bit word index (0..49)
    // addr[6]=0 block, addr[5:1]=lane=widx/2, addr[0]=half=widx%2
    //------------------------------------------------------------------
    task write_block_word;
        input integer widx;
        input [31:0]  wdata;
        begin
            tb_addr    = {1'b0, widx[5:1], widx[0]};
            tb_wr_data = wdata;
            tb_we      = 1'b1;
            #(CLK_PERIOD);
        end
    endtask

    //------------------------------------------------------------------
    // Task: pump_init / pump_next
    //------------------------------------------------------------------
    task sha3_sponge_pump_init;
        reg poll_rdy;
        begin
            tb_we=1'b0; tb_dut_init=1'b1; #(CLK_PERIOD);
            tb_dut_init=1'b0;
            poll_rdy=1'b1;
            while(poll_rdy) begin #(CLK_PERIOD); poll_rdy=(tb_rdy!==1'b1); end
        end
    endtask

    task sha3_sponge_pump_next;
        reg poll_rdy;
        begin
            tb_we=1'b0; tb_dut_next=1'b1; #(CLK_PERIOD);
            tb_dut_next=1'b0;
            poll_rdy=1'b1;
            while(poll_rdy) begin #(CLK_PERIOD); poll_rdy=(tb_rdy!==1'b1); end
        end
    endtask

    //------------------------------------------------------------------
    // Task: compare_output
    //------------------------------------------------------------------
    task compare_output;
        input [511:0] correct_hash;
        begin
            mismatch=1'b0; hash_shreg=correct_hash;
            for(i=0; i<output_words; i=i+1) begin
                tb_addr={1'b1,i[5:1],i[0]}; tb_we=1'b0; #(CLK_PERIOD);
                hash_word=tb_rd_data;
                $display("    word[%2d]  ref=%08h  got=%08h  %s",
                    i, hash_shreg[511-:32], hash_word,
                    (hash_shreg[511-:32]!==hash_word) ? "*** FAIL" : "ok");
                if(hash_shreg[511-:32]!==hash_word) begin
                    mismatch=1'b1; num_err=num_err+1; end
                hash_shreg={hash_shreg[479:0],{32{1'b0}}};
            end
            tb_addr=7'd0; tb_we=1'b0;
            if(mismatch) $display("    *** FAILED\n");
            else         $display("    *** PASSED\n");
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_empty_message
    // word[0]=0x06000000, word[N-1]=0x00000080, others=0
    //------------------------------------------------------------------
    task test_empty_message;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Empty msg -- %0d-bit hash, %0d-bit block",
                     output_size, block_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h06000000);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_single_byte
    // byte[0]=data_byte, then 0x06 domain byte at byte[1]
    // word[0] = {data_byte, 0x06, 0x00, 0x00}
    // word[block_words-1] = 0x00000080
    //------------------------------------------------------------------
    task test_single_byte;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        input [7:0]   data_byte;
        begin
            $display("*** Single byte 0x%02h -- %0d-bit hash",
                     data_byte, output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)
                    write_block_word(i, {data_byte, 8'h06, 16'h0000});
                else if(i==block_words-1)
                    write_block_word(i, 32'h00000080);
                else
                    write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_short_message "abc"
    // word[0]=0x61626306, word[N-1]=0x00000080
    //------------------------------------------------------------------
    task test_short_message;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Short msg (\"abc\") -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h61626306);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_alphabet  "abcdefghijklmnopqrstuvwxyz" (26 bytes)
    // word[0]=0x61626364 .. word[5]=0x75767778
    // word[6]=0x797a0600  (y=0x79, z=0x7a, 0x06 domain, 0x00)
    // word[block_words-1]=0x00000080
    //------------------------------------------------------------------
    task test_alphabet;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Alphabet a-z (26 bytes) -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                case(i)
                    0: write_block_word(i, 32'h61626364);
                    1: write_block_word(i, 32'h65666768);
                    2: write_block_word(i, 32'h696a6b6c);
                    3: write_block_word(i, 32'h6d6e6f70);
                    4: write_block_word(i, 32'h71727374);
                    5: write_block_word(i, 32'h75767778);
                    6: write_block_word(i, 32'h797a0600);
                    default: begin
                        if(i==block_words-1)
                            write_block_word(i, 32'h00000080);
                        else
                            write_block_word(i, 32'h00000000);
                    end
                endcase
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_exact_block_boundary
    // Message fills exactly ONE block (no room for padding in block 1)
    // Block 1: all block_words words = 0xA3A3A3A3 (init)
    // Block 2: word[0]=0x06000000, word[block_words-1]=0x00000080 (next)
    //------------------------------------------------------------------
    task test_exact_block_boundary;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Exact block boundary (0xA3 x %0d bytes) -- %0d-bit hash",
                     block_size>>3, output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);

            // Block 1: fill completely with 0xA3A3A3A3
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) write_block_word(i, 32'hA3A3A3A3);
                else              write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();

            // Block 2: padding only
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h06000000);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_next();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_long_A3  (200x 0xA3)
    //------------------------------------------------------------------
    task test_long_A3;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        reg done, pad_written;
        begin
            $display("*** Long msg 200x 0xA3 -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            total_bits=1600;
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) begin
                    write_block_word(i, 32'hA3A3A3A3);
                    total_bits=total_bits-32;
                end else write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            done=1'b0; pad_written=1'b0;
            while(!done) begin
                for(i=0; i<block_words; i=i+1) begin
                    if(total_bits>0) begin
                        write_block_word(i, 32'hA3A3A3A3);
                        total_bits=total_bits-32;
                    end else if(!pad_written) begin
                        if(i==block_words-1) begin
                            write_block_word(i, 32'h06000080); done=1'b1;
                        end else write_block_word(i, 32'h06000000);
                        pad_written=1'b1;
                    end else if(i==block_words-1) begin
                        write_block_word(i, 32'h00000080); done=1'b1;
                    end else write_block_word(i, 32'h00000000);
                end
                tb_we=1'b0; tb_addr=7'd0;
                sha3_sponge_pump_next();
            end
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_long_zeros  (200x 0x00)
    //------------------------------------------------------------------
    task test_long_zeros;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        reg done, pad_written;
        begin
            $display("*** Long msg 200x 0x00 -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            total_bits=1600;
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) begin
                    write_block_word(i, 32'h00000000);
                    total_bits=total_bits-32;
                end else write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            done=1'b0; pad_written=1'b0;
            while(!done) begin
                for(i=0; i<block_words; i=i+1) begin
                    if(total_bits>0) begin
                        write_block_word(i, 32'h00000000);
                        total_bits=total_bits-32;
                    end else if(!pad_written) begin
                        if(i==block_words-1) begin
                            write_block_word(i, 32'h06000080); done=1'b1;
                        end else write_block_word(i, 32'h06000000);
                        pad_written=1'b1;
                    end else if(i==block_words-1) begin
                        write_block_word(i, 32'h00000080); done=1'b1;
                    end else write_block_word(i, 32'h00000000);
                end
                tb_we=1'b0; tb_addr=7'd0;
                sha3_sponge_pump_next();
            end
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Main stimulus
    //------------------------------------------------------------------
    initial begin : sha3_test

        $display("==============================================");
        $display("  SHA3 Testbench  --  Full Test Suite");
        $display("==============================================\n");
        num_err=0;
        init_sim();
        reset_dut();

        // ---- Group 1: Empty message ----
        $display("=== Group 1: Empty message ===");
        test_empty_message(SHA3_224_EMPTY, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_empty_message(SHA3_256_EMPTY, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_empty_message(SHA3_384_EMPTY, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_empty_message(SHA3_512_EMPTY, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 2: Single byte 0x00 ----
        $display("=== Group 2: Single byte 0x00 ===");
        test_single_byte(SHA3_224_ZERO1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_256_ZERO1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_384_ZERO1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_512_ZERO1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'h00);

        // ---- Group 3: Single byte 0xFF ----
        $display("=== Group 3: Single byte 0xFF ===");
        test_single_byte(SHA3_224_FF1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_256_FF1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_384_FF1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_512_FF1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'hFF);

        // ---- Group 4: Single byte 'a' ----
        $display("=== Group 4: Single byte 'a' (0x61) ===");
        test_single_byte(SHA3_224_A1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_256_A1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_384_A1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_512_A1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'h61);

        // ---- Group 5: "abc" ----
        $display("=== Group 5: Short message 'abc' ===");
        test_short_message(SHA3_224_ABC, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_short_message(SHA3_256_ABC, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_short_message(SHA3_384_ABC, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_short_message(SHA3_512_ABC, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 6: Alphabet a-z ----
        $display("=== Group 6: Alphabet a-z (26 bytes) ===");
        test_alphabet(SHA3_224_AZ, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_alphabet(SHA3_256_AZ, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_alphabet(SHA3_384_AZ, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_alphabet(SHA3_512_AZ, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 7: Exact block boundary ----
        $display("=== Group 7: Exact block boundary ===");
        test_exact_block_boundary(SHA3_256_EXACT_BLK, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_exact_block_boundary(SHA3_512_EXACT_BLK, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 8: Long 200x 0xA3 ----
        $display("=== Group 8: Long message 200x 0xA3 ===");
        test_long_A3(SHA3_224_LONG, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_long_A3(SHA3_256_LONG, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_long_A3(SHA3_384_LONG, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_long_A3(SHA3_512_LONG, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 9: Long 200x 0x00 ----
        $display("=== Group 9: Long message 200x 0x00 ===");
        test_long_zeros(SHA3_224_ZEROS, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_long_zeros(SHA3_256_ZEROS, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_long_zeros(SHA3_384_ZEROS, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_long_zeros(SHA3_512_ZEROS, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        $display("==============================================");
        $display("  Testbench complete.");
        if(num_err==0) $display("  ALL TESTS PASSED.");
        else           $display("  %0d WORD(S) MISMATCHED.", num_err);
        $display("==============================================");

        $finish;
    end

endmodule//======================================================================
// tb_sha3.v — SHA3 Testbench với đầy đủ test cases
//
// Test cases:
//   Group 1 — Empty message          (đã có)
//   Group 2 — Single byte 0x00       (mới)
//   Group 3 — Single byte 0xFF       (mới)
//   Group 4 — Single byte 'a' 0x61   (mới)
//   Group 5 — Short "abc"            (đã có)
//   Group 6 — Alphabet a-z (26 bytes)(mới)
//   Group 7 — Exact block boundary   (mới)
//   Group 8 — Long 200x 0xA3         (đã có)
//   Group 9 — All zeros 200 bytes    (mới)
//======================================================================

`define SHA3_224_BLOCK_BITS  1152
`define SHA3_256_BLOCK_BITS  1088
`define SHA3_384_BLOCK_BITS   832
`define SHA3_512_BLOCK_BITS   576

`define SHA3_224_OUTPUT_BITS  224
`define SHA3_256_OUTPUT_BITS  256
`define SHA3_384_OUTPUT_BITS  384
`define SHA3_512_OUTPUT_BITS  512

module tb_sha3 ();

    //------------------------------------------------------------------
    // GROUP 1: Empty message
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_EMPTY = {
        224'h6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_EMPTY = {
        256'ha7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_EMPTY = {
        384'h0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_EMPTY =
        512'h00a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26;

    //------------------------------------------------------------------
    // GROUP 2: Single byte 0x00
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ZERO1 = {
        224'hbdd5167212d2dc69665f5a8875ab87f23d5ce7849132f56371a19096,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ZERO1 = {
        256'h5d53469f20fef4f8eab52b88044ede69c77a6a68a60728609fc4a65ff531e7d0,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ZERO1 = {
        384'h127677f8b66725bbcb7c3eae9698351ca41e0eb6d66c784bd28dcdb3b5fb12d0c8e840342db03ad1ae180b92e3504933,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ZERO1 =
        512'h7127aab211f82a18d06cf7578ff49d5089017944139aa60d8bee057811a15fb55a53887600a3eceba004de51105139f32506fe5b53e1913bfa6b32e716fe97da00;

    //------------------------------------------------------------------
    // GROUP 3: Single byte 0xFF
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_FF1 = {
        224'h624edc8a3c0c9d42bc224f0bf37040483432d7a1aeb68935e80f1e1c,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_FF1 = {
        256'h444b89ecce395aec5dc98f19defd3a23bca0822fc72226f58ca46a17eeeca442,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_FF1 = {
        384'hbb90261c81ad316a92b5a754b983c5f09c7f22a95c34af914a46cdc50704d91279db547e47dbb00f9e2310fce0b1a028,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_FF1 =
        512'ha6f098adf45424539eb214272e0436894bb6fe3f22f5bf45725e1d4f37313a9547415ca108ea84664995d9ccd3983dc21806765fb8e20d6b686ce51ee6583ec800;

    //------------------------------------------------------------------
    // GROUP 4: Single byte 'a' (0x61)
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_A1 = {
        224'h9e86ff69557ca95f405f081269685b38e3a819b309ee942f482b6a8b,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_A1 = {
        256'h80084bf2fba02475726feb2cab2d8215eab14bc6bdd8bfb2c8151257032ecd8b,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_A1 = {
        384'h1815f774f320491b48569efec794d249eeb59aae46d22bf77dafe25c5edc28d7ea44f93ee1234aa88f61c91912a4ccd9,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_A1 =
        512'h697f2d856172cb8309d6b8b97dac4de344b549d4dee61edfb4962d8698b7fa803f4f93ff24393586e28b5b957ac3d1d369420ce53332712f997bd336d09ab02a00;

    //------------------------------------------------------------------
    // GROUP 5: Short "abc"
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ABC = {
        224'he642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ABC = {
        256'h3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ABC = {
        384'hec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ABC =
        512'h00b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0;

    //------------------------------------------------------------------
    // GROUP 6: Alphabet a-z (26 bytes)
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_AZ = {
        224'h5cdeca81e123f87cad96b9cba999f16f6d41549608d4e0f4681b8239,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_AZ = {
        256'h7cab2dc765e21b241dbc1c255ce620b29f527c6d5e7f5f843e56288f0d707521,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_AZ = {
        384'hfed399d2217aaf4c717ad0c5102c15589e1c990cc2b9a5029056a7f7485888d6ab65db2370077a5cadb53fc9280d278f,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_AZ =
        512'haf328d17fa28753a3c9f5cb72e376b90440b96f0289e5703b729324a975ab384eda565fc92aaded143669900d761861687acdc0a5ffa358bd0571aaad80aca6800;

    //------------------------------------------------------------------
    // GROUP 7: Exact block boundary (0xA3 fills block exactly)
    // SHA3-256: 136 bytes = 34 words = exact 1 block
    // SHA3-512:  72 bytes = 18 words = exact 1 block
    //------------------------------------------------------------------
    localparam [511:0] SHA3_256_EXACT_BLK = {
        256'h0adf6bfb359ae40019b67d8c49c361574b70242a6b752de6f9e0d426ca177f7a,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_512_EXACT_BLK =
        512'hd24ce75b87c7be36e3fedbaa285f563d3efcc13663f5eb2fdd0c60033dab04e894d343b3971bc0c9ba30e0dde18106cbaaa955c8c3c0bf1ec3490aafcae15788;

    //------------------------------------------------------------------
    // GROUP 8: Long 200x 0xA3
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_LONG = {
        224'h9376816ABA503F72F96CE7EB65AC095DEEE3BE4BF9BBC2A1CB7E11E0,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_LONG = {
        256'h79F38ADEC5C20307A98EF76E8324AFBFD46CFD81B22E3973C65FA1BD9DE31787,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_LONG = {
        384'h1881DE2CA7E41EF95DC4732B8F5F002B189CC1E42B74168ED1732649CE1DBCDD76197A31FD55EE989F2D7050DD473E8F,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_LONG =
        512'hE76DFAD22084A8B1467FCF2FFA58361BEC7628EDF5F3FDC0E4805DC48CAEECA81B7C13C30ADF52A3659584739A2DF46BE589C51CA1A4A8416DF6545A1CE8BA00;

    //------------------------------------------------------------------
    // GROUP 9: All zeros 200 bytes
    //------------------------------------------------------------------
    localparam [511:0] SHA3_224_ZEROS = {
        224'hc183b88a86c9c2d9d71f44d96983ec428d0fb59f923e337d8b339e0f,
        {(512-224){1'b0}} };
    localparam [511:0] SHA3_256_ZEROS = {
        256'h2b43036c229ba512995f91fdb46fcd5327a4dc834d86d6e0f58a08053346dc2e,
        {(512-256){1'b0}} };
    localparam [511:0] SHA3_384_ZEROS = {
        384'hd594703d816a1aeb814436c53ec54d7100c5edfb4f806a253fbf6b052864d1000b5a1a66a066b5d680bfae9ac3e5bcf6,
        {(512-384){1'b0}} };
    localparam [511:0] SHA3_512_ZEROS =
        512'hfee1198b89e041af5a26a217e4217a66c628c78d11c1fbb482b3643153f3cf0c04ae421c7e530e19584a494c1f3bd4713ca169a98b937ddf0b9d4d09fadecde900;

    //------------------------------------------------------------------
    // Timing
    //------------------------------------------------------------------
    parameter CLK_HALF_PERIOD = 2;
    parameter CLK_PERIOD      = 2 * CLK_HALF_PERIOD;

    //------------------------------------------------------------------
    // Signals
    //------------------------------------------------------------------
    reg         tb_clk;
    reg         tb_rst_n;
    reg         tb_we;
    reg  [6:0]  tb_addr;
    reg  [31:0] tb_wr_data;
    reg         tb_dut_init;
    reg         tb_dut_next;
    wire [31:0] tb_rd_data;
    wire        tb_rdy;

    integer     i;
    integer     num_err;
    integer     block_words;
    integer     output_words;
    integer     total_bits;

    reg [511:0] hash_shreg;
    reg [31:0]  hash_word;
    reg         mismatch;

    //------------------------------------------------------------------
    // DUT
    //------------------------------------------------------------------
    sha3 dut (
        .clk    (tb_clk),
        .nreset (tb_rst_n),
        .w      (tb_we),
        .addr   (tb_addr),
        .din    (tb_wr_data),
        .dout   (tb_rd_data),
        .init   (tb_dut_init),
        .next   (tb_dut_next),
        .ready  (tb_rdy)
    );

    initial tb_clk = 1'b0;
    always  #CLK_HALF_PERIOD tb_clk = ~tb_clk;

    //------------------------------------------------------------------
    // Task: init_sim
    //------------------------------------------------------------------
    task init_sim;
        begin
            tb_clk=1'b0; tb_rst_n=1'b0; tb_we=1'b0;
            tb_addr=7'd0; tb_wr_data=32'h0;
            tb_dut_init=1'b0; tb_dut_next=1'b0;
        end
    endtask

    //------------------------------------------------------------------
    // Task: reset_dut
    //------------------------------------------------------------------
    task reset_dut;
        begin
            $display("*** Toggling reset...");
            tb_rst_n=1'b0; #(4*CLK_HALF_PERIOD);
            tb_rst_n=1'b1; #(CLK_PERIOD);
        end
    endtask

    //------------------------------------------------------------------
    // Task: write_block_word
    // widx = 32-bit word index (0..49)
    // addr[6]=0 block, addr[5:1]=lane=widx/2, addr[0]=half=widx%2
    //------------------------------------------------------------------
    task write_block_word;
        input integer widx;
        input [31:0]  wdata;
        begin
            tb_addr    = {1'b0, widx[5:1], widx[0]};
            tb_wr_data = wdata;
            tb_we      = 1'b1;
            #(CLK_PERIOD);
        end
    endtask

    //------------------------------------------------------------------
    // Task: pump_init / pump_next
    //------------------------------------------------------------------
    task sha3_sponge_pump_init;
        reg poll_rdy;
        begin
            tb_we=1'b0; tb_dut_init=1'b1; #(CLK_PERIOD);
            tb_dut_init=1'b0;
            poll_rdy=1'b1;
            while(poll_rdy) begin #(CLK_PERIOD); poll_rdy=(tb_rdy!==1'b1); end
        end
    endtask

    task sha3_sponge_pump_next;
        reg poll_rdy;
        begin
            tb_we=1'b0; tb_dut_next=1'b1; #(CLK_PERIOD);
            tb_dut_next=1'b0;
            poll_rdy=1'b1;
            while(poll_rdy) begin #(CLK_PERIOD); poll_rdy=(tb_rdy!==1'b1); end
        end
    endtask

    //------------------------------------------------------------------
    // Task: compare_output
    //------------------------------------------------------------------
    task compare_output;
        input [511:0] correct_hash;
        begin
            mismatch=1'b0; hash_shreg=correct_hash;
            for(i=0; i<output_words; i=i+1) begin
                tb_addr={1'b1,i[5:1],i[0]}; tb_we=1'b0; #(CLK_PERIOD);
                hash_word=tb_rd_data;
                $display("    word[%2d]  ref=%08h  got=%08h  %s",
                    i, hash_shreg[511-:32], hash_word,
                    (hash_shreg[511-:32]!==hash_word) ? "*** FAIL" : "ok");
                if(hash_shreg[511-:32]!==hash_word) begin
                    mismatch=1'b1; num_err=num_err+1; end
                hash_shreg={hash_shreg[479:0],{32{1'b0}}};
            end
            tb_addr=7'd0; tb_we=1'b0;
            if(mismatch) $display("    *** FAILED\n");
            else         $display("    *** PASSED\n");
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_empty_message
    // word[0]=0x06000000, word[N-1]=0x00000080, others=0
    //------------------------------------------------------------------
    task test_empty_message;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Empty msg -- %0d-bit hash, %0d-bit block",
                     output_size, block_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h06000000);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_single_byte
    // byte[0]=data_byte, then 0x06 domain byte at byte[1]
    // word[0] = {data_byte, 0x06, 0x00, 0x00}
    // word[block_words-1] = 0x00000080
    //------------------------------------------------------------------
    task test_single_byte;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        input [7:0]   data_byte;
        begin
            $display("*** Single byte 0x%02h -- %0d-bit hash",
                     data_byte, output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)
                    write_block_word(i, {data_byte, 8'h06, 16'h0000});
                else if(i==block_words-1)
                    write_block_word(i, 32'h00000080);
                else
                    write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_short_message "abc"
    // word[0]=0x61626306, word[N-1]=0x00000080
    //------------------------------------------------------------------
    task test_short_message;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Short msg (\"abc\") -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h61626306);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_alphabet  "abcdefghijklmnopqrstuvwxyz" (26 bytes)
    // word[0]=0x61626364 .. word[5]=0x75767778
    // word[6]=0x797a0600  (y=0x79, z=0x7a, 0x06 domain, 0x00)
    // word[block_words-1]=0x00000080
    //------------------------------------------------------------------
    task test_alphabet;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Alphabet a-z (26 bytes) -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            for(i=0; i<50; i=i+1) begin
                case(i)
                    0: write_block_word(i, 32'h61626364);
                    1: write_block_word(i, 32'h65666768);
                    2: write_block_word(i, 32'h696a6b6c);
                    3: write_block_word(i, 32'h6d6e6f70);
                    4: write_block_word(i, 32'h71727374);
                    5: write_block_word(i, 32'h75767778);
                    6: write_block_word(i, 32'h797a0600);
                    default: begin
                        if(i==block_words-1)
                            write_block_word(i, 32'h00000080);
                        else
                            write_block_word(i, 32'h00000000);
                    end
                endcase
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_exact_block_boundary
    // Message fills exactly ONE block (no room for padding in block 1)
    // Block 1: all block_words words = 0xA3A3A3A3 (init)
    // Block 2: word[0]=0x06000000, word[block_words-1]=0x00000080 (next)
    //------------------------------------------------------------------
    task test_exact_block_boundary;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        begin
            $display("*** Exact block boundary (0xA3 x %0d bytes) -- %0d-bit hash",
                     block_size>>3, output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);

            // Block 1: fill completely with 0xA3A3A3A3
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) write_block_word(i, 32'hA3A3A3A3);
                else              write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();

            // Block 2: padding only
            for(i=0; i<50; i=i+1) begin
                if(i==0)               write_block_word(i, 32'h06000000);
                else if(i==block_words-1) write_block_word(i, 32'h00000080);
                else                   write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_next();
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_long_A3  (200x 0xA3)
    //------------------------------------------------------------------
    task test_long_A3;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        reg done, pad_written;
        begin
            $display("*** Long msg 200x 0xA3 -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            total_bits=1600;
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) begin
                    write_block_word(i, 32'hA3A3A3A3);
                    total_bits=total_bits-32;
                end else write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            done=1'b0; pad_written=1'b0;
            while(!done) begin
                for(i=0; i<block_words; i=i+1) begin
                    if(total_bits>0) begin
                        write_block_word(i, 32'hA3A3A3A3);
                        total_bits=total_bits-32;
                    end else if(!pad_written) begin
                        if(i==block_words-1) begin
                            write_block_word(i, 32'h06000080); done=1'b1;
                        end else write_block_word(i, 32'h06000000);
                        pad_written=1'b1;
                    end else if(i==block_words-1) begin
                        write_block_word(i, 32'h00000080); done=1'b1;
                    end else write_block_word(i, 32'h00000000);
                end
                tb_we=1'b0; tb_addr=7'd0;
                sha3_sponge_pump_next();
            end
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Task: test_long_zeros  (200x 0x00)
    //------------------------------------------------------------------
    task test_long_zeros;
        input [511:0] correct_hash;
        input integer block_size;
        input integer output_size;
        reg done, pad_written;
        begin
            $display("*** Long msg 200x 0x00 -- %0d-bit hash", output_size);
            block_words=block_size>>5; output_words=output_size>>5;
            #(4*CLK_PERIOD);
            total_bits=1600;
            for(i=0; i<50; i=i+1) begin
                if(i<block_words) begin
                    write_block_word(i, 32'h00000000);
                    total_bits=total_bits-32;
                end else write_block_word(i, 32'h00000000);
            end
            tb_we=1'b0; tb_addr=7'd0;
            sha3_sponge_pump_init();
            done=1'b0; pad_written=1'b0;
            while(!done) begin
                for(i=0; i<block_words; i=i+1) begin
                    if(total_bits>0) begin
                        write_block_word(i, 32'h00000000);
                        total_bits=total_bits-32;
                    end else if(!pad_written) begin
                        if(i==block_words-1) begin
                            write_block_word(i, 32'h06000080); done=1'b1;
                        end else write_block_word(i, 32'h06000000);
                        pad_written=1'b1;
                    end else if(i==block_words-1) begin
                        write_block_word(i, 32'h00000080); done=1'b1;
                    end else write_block_word(i, 32'h00000000);
                end
                tb_we=1'b0; tb_addr=7'd0;
                sha3_sponge_pump_next();
            end
            compare_output(correct_hash);
        end
    endtask

    //------------------------------------------------------------------
    // Main stimulus
    //------------------------------------------------------------------
    initial begin : sha3_test

        $display("==============================================");
        $display("  SHA3 Testbench  --  Full Test Suite");
        $display("==============================================\n");
        num_err=0;
        init_sim();
        reset_dut();

        // ---- Group 1: Empty message ----
        $display("=== Group 1: Empty message ===");
        test_empty_message(SHA3_224_EMPTY, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_empty_message(SHA3_256_EMPTY, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_empty_message(SHA3_384_EMPTY, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_empty_message(SHA3_512_EMPTY, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 2: Single byte 0x00 ----
        $display("=== Group 2: Single byte 0x00 ===");
        test_single_byte(SHA3_224_ZERO1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_256_ZERO1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_384_ZERO1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'h00);
        test_single_byte(SHA3_512_ZERO1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'h00);

        // ---- Group 3: Single byte 0xFF ----
        $display("=== Group 3: Single byte 0xFF ===");
        test_single_byte(SHA3_224_FF1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_256_FF1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_384_FF1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'hFF);
        test_single_byte(SHA3_512_FF1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'hFF);

        // ---- Group 4: Single byte 'a' ----
        $display("=== Group 4: Single byte 'a' (0x61) ===");
        test_single_byte(SHA3_224_A1, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_256_A1, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_384_A1, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS, 8'h61);
        test_single_byte(SHA3_512_A1, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS, 8'h61);

        // ---- Group 5: "abc" ----
        $display("=== Group 5: Short message 'abc' ===");
        test_short_message(SHA3_224_ABC, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_short_message(SHA3_256_ABC, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_short_message(SHA3_384_ABC, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_short_message(SHA3_512_ABC, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 6: Alphabet a-z ----
        $display("=== Group 6: Alphabet a-z (26 bytes) ===");
        test_alphabet(SHA3_224_AZ, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_alphabet(SHA3_256_AZ, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_alphabet(SHA3_384_AZ, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_alphabet(SHA3_512_AZ, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 7: Exact block boundary ----
        $display("=== Group 7: Exact block boundary ===");
        test_exact_block_boundary(SHA3_256_EXACT_BLK, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_exact_block_boundary(SHA3_512_EXACT_BLK, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 8: Long 200x 0xA3 ----
        $display("=== Group 8: Long message 200x 0xA3 ===");
        test_long_A3(SHA3_224_LONG, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_long_A3(SHA3_256_LONG, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_long_A3(SHA3_384_LONG, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_long_A3(SHA3_512_LONG, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        // ---- Group 9: Long 200x 0x00 ----
        $display("=== Group 9: Long message 200x 0x00 ===");
        test_long_zeros(SHA3_224_ZEROS, `SHA3_224_BLOCK_BITS, `SHA3_224_OUTPUT_BITS);
        test_long_zeros(SHA3_256_ZEROS, `SHA3_256_BLOCK_BITS, `SHA3_256_OUTPUT_BITS);
        test_long_zeros(SHA3_384_ZEROS, `SHA3_384_BLOCK_BITS, `SHA3_384_OUTPUT_BITS);
        test_long_zeros(SHA3_512_ZEROS, `SHA3_512_BLOCK_BITS, `SHA3_512_OUTPUT_BITS);

        $display("==============================================");
        $display("  Testbench complete.");
        if(num_err==0) $display("  ALL TESTS PASSED.");
        else           $display("  %0d WORD(S) MISMATCHED.", num_err);
        $display("==============================================");

        $finish;
    end

endmodule