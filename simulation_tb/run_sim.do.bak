# stop any simulation that is currently running
quit -sim

# create the default "work" library
vlib work

# compile tất cả file .v trong thư mục cha (DUT)
vlog -nolock sha3.v

# compile testbench trong thư mục hiện tại
vlog -nolock tb_sha3.v

# start simulator với Altera libraries
vsim work.SHA3 -Lf 220model -Lf altera_mf_ver -Lf verilog

# chạy hết simulation
run -all